<UserControl x:Class="CompanyManagerSystem.View.subView.Dialog.NoticeInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompanyManagerSystem.View.subView.Dialog"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             DataContext="{Binding Source={StaticResource Locator},Path=Notice}"
             d:DesignHeight="450" d:DesignWidth="600" Background="Transparent">
    <Grid Background="White" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="330"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <!--// 信息通知 //-->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalAlignment="Top" MaxHeight="165"
                      Grid.RowSpan="2" HorizontalAlignment="Center" Panel.ZIndex="1">
            <StackPanel VerticalAlignment="Top">
                <StackPanel hc:Growl.Token="NoticeInfoSuccessMsg" VerticalAlignment="Center" Margin="0 5"/>
                <StackPanel hc:Growl.Token="NoticeInfoWarningMsg" VerticalAlignment="Center" Margin="0 5"/>
                <StackPanel hc:Growl.Token="NoticeInfoErroMsg" VerticalAlignment="Center" Margin="0 5"/>
            </StackPanel>
        </ScrollViewer>
        
        <!--// 标题 /-->
        <Grid Margin="20 20 20 10">
            <TextBlock Text="{Binding DialogTitle}" VerticalAlignment="Center" FontSize="18"/>
            <Button Style="{StaticResource closeStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="hc:ControlCommands.Close">
                <TextBlock Text="&#xeb6a;" FontFamily="/Themes/Style/#iconfont" FontSize="16"/>
            </Button>
        </Grid>
        
        <!--内容-->
        <Grid Grid.Row="1" Margin="20 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <StackPanel >
                <hc:TextBox x:Name="noticeName" hc:InfoElement.Title="公告标题" hc:InfoElement.Placeholder="请输入公告内容"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Text="{Binding DialogNotice.Notice.NoticeTitle}" FontWeight="Bold"
                            Width="540" Height="36" LostFocus="TextBox_LostFocus"/>
                <TextBlock Name="noticeNameInfo" Text="岗位名称不能为空" Foreground="#f56c6c" Margin="90 2 0 5" Visibility="Hidden"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Top">
                <TextBlock Grid.Row="1" Text="状态:" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"
                          Margin="35 0"/>
                <RadioButton Content="正常" VerticalAlignment="Center" IsChecked="{Binding DialogNotice.Notice.NoticeStatus}" 
                          HorizontalAlignment="Left" Margin="0 0 20 0"/>
                <RadioButton Content="停用" VerticalAlignment="Center" IsChecked="{Binding DialogNotice.Notice.NoticeStatus, Converter={StaticResource Boolean2BooleanReConverter}, ConverterParameter=停用;正常}"
                          HorizontalAlignment="Left"/>
            </StackPanel>

            <hc:TextBox Grid.Row="2" hc:InfoElement.Title="公告内容" hc:InfoElement.Placeholder="请输入公告内容"
                        Text="{Binding DialogNotice.Notice.NoticeContent}"
                        VerticalAlignment="Top" VerticalContentAlignment="Top" TextWrapping="Wrap" FontWeight="Bold"
                        Margin="10 0 10 0" Height="150" MaxHeight="150" Width="540"/>

        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Style="{StaticResource ButtonPrimary}" Content="确 认" Width="80" Height="32"
                    Command="{Binding SubmitNoticeInfoCommand}"/>
            <Button Style="{StaticResource ButtonDefault}" Content="取 消" Width="80" Height="32"
                    Command="hc:ControlCommands.Close" Margin="20 0"/>
        </StackPanel>
        
    </Grid>
</UserControl>
