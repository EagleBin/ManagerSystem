<UserControl x:Class="CompanyManagerSystem.View.subView.InformationManager.Dialog.CourseInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompanyManagerSystem.View.subView.InformationManager.Dialog"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             xmlns:converter="clr-namespace:ManagerSystem.Utils.Converter;assembly=ManagerSystem.Utils"
             DataContext="{Binding Source={StaticResource Locator},Path=Course}">
    <UserControl.Resources>
        <converter:CourseTypeConverter x:Key="CourseTypeConverter"/>
    </UserControl.Resources>
    <!--// 加载命令 //-->
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding PostInfoDialogUnloadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Width="600" CornerRadius="3" Background="White" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="230"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <!--// 信息弹窗 //-->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Grid.RowSpan="2" MaxHeight="165"
                          VerticalAlignment="Top" HorizontalAlignment="Center" Panel.ZIndex="1">
                <StackPanel VerticalAlignment="Top" Margin="5">
                    <StackPanel hc:Growl.Token="CourseInfoSuccessMsg" Margin="5"></StackPanel>
                    <StackPanel hc:Growl.Token="CourseInfoWarningMsg" Margin="5"></StackPanel>
                    <StackPanel hc:Growl.Token="CourseInfoErrorMsg" Margin="5"></StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--// 标题和关闭 //-->
            <Grid Margin="20 20 20 10">
                <!--// 标题(添加/修改) //-->
                <TextBlock Text="{Binding DialogTitle}" Foreground="#303133" FontSize="18" VerticalAlignment="Center"/>
                <!--// 关闭按钮 //-->
                <Button Style="{StaticResource closeDialogStyle}" Command="hc:ControlCommands.Close" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="&#xeb6a;" FontFamily="/Themes/Style/#iconfont" FontSize="16"/>
                </Button>
            </Grid>

            <!--// 内容 //-->
            <Grid Grid.Row="1" Margin="20 30">

                <StackPanel>
                    <!--// 岗位名称 //-->
                    <StackPanel VerticalAlignment="Center">
                        <hc:TextBox x:Name="courseName" Text="{Binding DialogCourse.Course.Name}" hc:InfoElement.Placeholder="请输入课程名称"
                                    hc:InfoElement.Title="课程名称" hc:InfoElement.TitlePlacement="Left"
                                    GotFocus="courseName_GotFocus" LostFocus="courseName_LostFocus"/>
                        <TextBlock Name="courseNameInfo" Text="课程名称不能为空" Foreground="#f56c6c" Margin="90 2 0 5" Visibility="Hidden"/>
                    </StackPanel>

                    <StackPanel>
                        <hc:ComboBox hc:InfoElement.Title="课程类型" hc:InfoElement.Placeholder="请选择课程类型" 
                                     SelectedValue="{Binding DialogCourse.Course.CourseType, Converter={StaticResource CourseTypeConverter}}"
                                     ItemsSource="{Binding DialogCourseTypeList}" x:Name="courseType"
                                     GotFocus="courseType_GotFocus" LostFocus="courseType_LostFocus"/>
                        <TextBlock Name="courseTypeInfo" Text="课程名称不能为空" Foreground="#f56c6c" Margin="90 2 0 5" Visibility="Hidden"/>

                    </StackPanel>
                </StackPanel>
                
               
                
            </Grid>

            <Grid Grid.Row="2" Margin="20 10 20 20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Command="{Binding SubmitCourseInfoCommand}" Content="确 认" Style="{StaticResource ButtonPrimary}"
                            Height="36" Width="74" FontSize="14" Cursor="Hand"/>
                    <Button Command="hc:ControlCommands.Close" Content="取 消" Style="{StaticResource ButtonDefault}"
                            Height="36" Width="74" FontSize="14" Cursor="Hand" Margin="10 0 0 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
