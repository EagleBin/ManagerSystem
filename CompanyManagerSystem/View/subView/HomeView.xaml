<UserControl x:Class="CompanyManagerSystem.View.subView.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CompanyManagerSystem.View.subView"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             DataContext="{Binding Source={StaticResource Locator}, Path=Home}">

    <UserControl.Resources>
        <!-- 自定义样式 -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0 0 0 2"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="#0E78D1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0E78D1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0A5BA1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#33000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#33000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <!-- 顶部导航栏 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 主导航菜单 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F5F5F5" Height="48" >
            <Button Content="首页" Style="{StaticResource NavigationButtonStyle}" FontWeight="Bold" Margin="32 0"/>
            <Button Content="信息管理" Style="{StaticResource NavigationButtonStyle}" 
                    Command="{Binding NavigateToInfoManagementCommand}" Margin="32 0"/>
            <Button Content="系统管理" Style="{StaticResource NavigationButtonStyle}" 
                    Command="{Binding NavigateToSystemManagementCommand}" Margin="32 0"/>
        </StackPanel>
        <TextBlock Text="{Binding UserName}" Margin="0 0 50 16" Foreground="#666" HorizontalAlignment="Right"/>

        <!-- 公告栏 -->
        <Grid Grid.Row="1" Background="#FFFBE6" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📢" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding LatestAnnouncement.Notice.NoticeContent}" 
                           Foreground="#666" VerticalAlignment="Center" Margin="0 4"/>
            </ScrollViewer>
        </Grid>

        <!-- 数据卡片区域 -->
        <Grid Grid.Row="2" Margin="0 8 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 信息管理数据卡片 -->
            <TextBlock Grid.Row="1" Text="信息概览" FontSize="16" FontWeight="Bold" Margin="0 0 0 0" />
            <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0 0 0 0">
                <!-- 学生总数卡片 -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Background="AliceBlue">
                    <StackPanel  HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StudentCount}" FontSize="40" FontWeight="Bold" 
                                   Foreground="#1890FF" Margin="0 10 0 0" />
                        <TextBlock Text="学生总数" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 班级总数卡片 -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Background="AliceBlue">
                    <StackPanel  HorizontalAlignment="Center" >
                        <TextBlock Text="{Binding ClassCount}" FontSize="36" FontWeight="Bold" 
                                   Foreground="#4CAF50" Margin="0 10 0 0"/>
                        <TextBlock Text="班级总数" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 教师总数卡片 -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Background="AliceBlue">
                    <StackPanel HorizontalAlignment="Center" >

                        <TextBlock Text="{Binding TeacherCount}" FontSize="36" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0 10 0 0"/>
                        <TextBlock Text="教师总数" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 一本率卡片 -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Background="AliceBlue">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PassRate}" FontSize="36" FontWeight="Bold" 
                                   Foreground="#FF4444" Margin="0 10 0 0"/>
                        <TextBlock Text="一本率" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 系统管理数据卡片 -->
            <TextBlock Grid.Row="3" Text="系统状态" FontSize="16" FontWeight="Bold" Margin="0 0 0 0" />
            <UniformGrid Grid.Row="4" Rows="1" Columns="3" Margin="0 8 0 0">
                <!-- 用户总数 -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Background="AliceBlue">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding UserCount}" FontSize="36" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0 10 0 0"/>
                        <TextBlock Text="用户总数" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 权限异常卡片 -->
                <Border Style="{StaticResource CardStyle}" Margin="5"  Background="AliceBlue">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding UserCount}" FontSize="36" FontWeight="Bold" 
                                   Foreground="#FF9800" Margin="0 10 0 0"/>
                        <TextBlock Text="部门总数" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 系统公告卡片 -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Background="AliceBlue">
                    <StackPanel HorizontalAlignment="Center" >
                        <TextBlock Text="{Binding AnnouncementCount}" FontSize="36" FontWeight="Bold" 
                                   Foreground="#1890FF" Margin="0 10 0 0"/>
                        <TextBlock Text="系统公告" Foreground="#909399" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 图表区域 -->
            <TextBlock Grid.Row="5" Text="数据统计" FontSize="16" FontWeight="Bold" Margin="0 0 0 0" />
            <Grid Grid.Row="6" Margin="0 8 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 本周成绩趋势图 -->
                <Border Style="{StaticResource CardStyle}" Margin="5 0 5 0" Grid.Column="0">
                    <StackPanel VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="各年级历次月考成绩趋势" FontSize="14" FontWeight="Bold" Margin="10 0 10 0"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="ForestGreen" Width="8" Height="8"/>
                                <TextBlock Text="高一" Margin="5 0 10 0"/>
                                <Border Background="Purple" Width="8" Height="8"/>
                                <TextBlock Text="高二" Margin="5 0 10 0"/>
                                <Border Background="Red" Width="8" Height="8"/>
                                <TextBlock Text="高三" Margin="5 0 10 0"/>
                            </StackPanel>
                        </StackPanel>
                        <lvc:CartesianChart Series="{Binding GradeScoreTrends}" Height="170">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding ExamNames}">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="分数" MinValue="300" MaxValue="700">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="50"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </StackPanel>
                </Border>

                <!-- 各个年级500分以上比例 -->
                <Border Style="{StaticResource CardStyle}" Margin="5 0 5 0" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Text="500分以上在各个年级比例" FontWeight="Bold" FontSize="14" Margin="10 10 0 0"></TextBlock>
                        <lvc:PieChart 
                            Series="{Binding GradeDistribution}" 
                            Margin="10"
                            LegendLocation="Right" 
                            Hoverable="True"
                            Width="250"
                            Height="150">
                        </lvc:PieChart>
                    </StackPanel>

                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl> 